# Tea-Leaves Platform Environment Configuration
# Copy this file to .env and fill in your actual values

# Google Cloud Configuration
GOOGLE_CLOUD_API_KEY=your_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
GOOGLE_CLOUD_REGION=your_region_here

# Gemma AI Configuration
GEMMA_URL=https://your-gemma-endpoint.run.app
GEMMA_MODEL=gemma3:4b
GEMMA_API_VERSION=v1beta

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/tea_leaves_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tea_leaves_db
DATABASE_USER=tea_leaves_user
DATABASE_PASSWORD=your_secure_password_here

# Blockchain Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BINANCE_RPC_URL=https://bsc-dataseed.binance.org
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# API Configuration
API_PORT=3000
PROXY_PORT=3002
FRONTEND_PORT=3001

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# External APIs
COINGECKO_API_KEY=your_coingecko_api_key_here
MESSARI_API_KEY=your_messari_api_key_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=tea-leaves.log

# Feature Flags
ENABLE_AI_AGENTS=true
ENABLE_BLOCKCHAIN_INTEGRATION=true
ENABLE_ANALYTICS=true 