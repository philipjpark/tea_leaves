# tea_leaves Bartering 2.0 Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# PLATFORM CONFIGURATION
# =============================================================================
PLATFORM_NAME=tea_leaves
PLATFORM_VERSION=2.0.0
ENVIRONMENT=development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000,https://tea-leaves.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://tea_leaves_user:password@localhost:5432/tea_leaves
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tea_leaves
DB_USER=tea_leaves_user
DB_PASSWORD=your_secure_password_here

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# BNB Chain (BSC)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_CHAIN_ID=97
BSC_NETWORK=testnet
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Contract Addresses (BNB Chain)
ASSET_TOKENIZATION_ADDRESS=0x0000000000000000000000000000000000000000
BARTERING_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
LIQUIDITY_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# Solana (Future Support)
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_solana_private_key_here

# =============================================================================
# BARTERING CONFIGURATION
# =============================================================================
MAX_OFFER_EXPIRY_HOURS=168
MIN_BARTER_AMOUNT=1
MAX_BARTER_AMOUNT=1000000
DEFAULT_SLIPPAGE_TOLERANCE=0.5
MAX_CONCURRENT_OFFERS=10

# =============================================================================
# ASSET TOKENIZATION CONFIGURATION
# =============================================================================
MIN_TOKEN_NAME_LENGTH=2
MAX_TOKEN_NAME_LENGTH=7
MIN_TOKEN_SYMBOL_LENGTH=2
MAX_TOKEN_SYMBOL_LENGTH=7
MAX_METADATA_URI_LENGTH=200
DEFAULT_TOKEN_DECIMALS=6

# =============================================================================
# AI INTEGRATION 
# =============================================================================
GEMMA_URL=https://yoree-gemma-827561407333.europe-west1.run.app
GEMMA_MODEL=gemma3:4b
GEMMA_MAX_TOKENS=2048
GEMMA_TEMPERATURE=0.7

# AI Agent Configuration
SEMANTIC_ANALYZER_ENABLED=true
FUNDRAISER_AGENT_ENABLED=true
EXECUTION_AGENT_ENABLED=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
API_RATE_LIMIT=100
MAX_REQUEST_SIZE=10MB
TIMEOUT_SECONDS=30

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
KEY_DERIVATION_FUNCTION=PBKDF2

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
ALERTING_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
PERFORMANCE_TRACKING=true
SLOW_QUERY_THRESHOLD=1000

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# Data Sources
COINBASE_ENABLED=true
BINANCE_ENABLED=true
COINMARKETCAP_ENABLED=true
PYTH_NETWORK_ENABLED=true

# AI/ML Services
GOOGLE_AI_PLATFORM_ENABLED=true
VERTEX_AI_ENABLED=true
BIGQUERY_ENABLED=true

# Blockchain Services
CHAINLINK_ENABLED=true
PYTH_ENABLED=true
BAND_PROTOCOL_ENABLED=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
DOCKER_ENABLED=true
KUBERNETES_ENABLED=false
AUTO_SCALING_ENABLED=true
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
NODE_ENV=development
DEBUG=true
TESTING_ENABLED=true
MOCK_DATA_ENABLED=true

# =============================================================================
# THIRD-PARTY API KEYS
# =============================================================================
# Add your actual API keys here
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# =============================================================================
# NOTIFICATION & ALERTING
# =============================================================================
# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@tea-leaves.com

# Webhook Configuration
DISCORD_WEBHOOK_URL=your_discord_webhook_url
SLACK_WEBHOOK_URL=your_slack_webhook_url
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id 